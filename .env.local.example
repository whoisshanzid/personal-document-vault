# WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed DocumentVault contract address (Sepolia)
NEXT_PUBLIC_CONTRACT_ADDRESS=

NEXT_PUBLIC_CHAIN_ID=11155111        # Sepolia

# Optional: custom Sepolia RPC (Alchemy/Infura). Falls back to the public RPC.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Server-side only — never expose with NEXT_PUBLIC_
MONGODB_URI=
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Optional:
# Gateway used by client-side "Open" links (defaults to gateway.pinata.cloud)
#NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
# Contract deployment block — bounds the getLogs scan for "Shared by me"
#NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=0
